{
	"manifest_version": 3,
	"name": "Ronda",
	"short_name": "Ronda",
	"version": "0.4.0",
	"description": "__MSG_extDescription__",
	"default_locale": "en",
	"minimum_chrome_version": "110",

	"permissions": [
		"tabs",
		"storage",
		"webNavigation"
	],

	"background": {
		"service_worker": "background.js"
	},

	"icons": {
		"16": "assets/icon-16.png",
		"32": "assets/icon-32.png",
		"48": "assets/icon-48.png",
		"128": "assets/icon-128.png"
	},

	"action": {
		"default_title": "__MSG_actionTitleOn__",
		"default_icon": {
			"16": "assets/icon-16.png",
			"32": "assets/icon-32.png"
		}
	}
}
